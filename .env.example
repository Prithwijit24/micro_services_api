# =============================================================================
# AI Infrastructure Stack — environment configuration
# Copy this file to .env and fill in real values before running `make up`.
# Never commit the real .env file.
# =============================================================================

# ---------------------------------------------------------------------------
# Reverse proxy / domain
# ---------------------------------------------------------------------------
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
CADDY_ACME_EMAIL=admin@example.com
# MONITOR_DOMAIN=monitor.example.com
# MONITOR_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=aistack
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aistack
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aistack:changeme@postgres:5432/aistack

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379/0

# ---------------------------------------------------------------------------
# Neo4j
# ---------------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://neo4j:7687
NEO4J_PAGECACHE=512M
NEO4J_HEAP_MAX=1G

# ---------------------------------------------------------------------------
# ChromaDB
# ---------------------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ---------------------------------------------------------------------------
# SearXNG
# ---------------------------------------------------------------------------
SEARXNG_BASE_URL=http://localhost:8080/
SEARXNG_URL=http://searxng:8080

# ---------------------------------------------------------------------------
# Firecrawl
# ---------------------------------------------------------------------------
FIRECRAWL_URL=http://firecrawl:3002
FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# Browser (Camoufox + Playwright)
# ---------------------------------------------------------------------------
# Leave blank to launch a local headless Firefox inside the browser container.
# Set to a Camoufox server websocket endpoint to connect to a remote instance.
CAMOUFOX_WS_ENDPOINT=

# ---------------------------------------------------------------------------
# YouTube (yt-dlp)
# ---------------------------------------------------------------------------
YOUTUBE_DOWNLOAD_DIR=/opt/data/youtube
YOUTUBE_MAX_CONCURRENT_DOWNLOADS=2

# ---------------------------------------------------------------------------
# Hugging Face / model cache (shared across embed, clip, reranker)
# ---------------------------------------------------------------------------
HF_HOME=/root/.cache/huggingface
TRANSFORMERS_CACHE=/root/.cache/huggingface
HF_HUB_DISABLE_TELEMETRY=1
EMBED_MODEL=BAAI/bge-small-en-v1.5
CLIP_MODEL=openai/clip-vit-base-patch32
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------------------------------------------------------------------------
# Internal service URLs (used by the gateway; defaults match compose service
# names, override only for non-standard topologies)
# ---------------------------------------------------------------------------
SEARCH_SERVICE_URL=http://search:8000
CRAWL_SERVICE_URL=http://crawl:8000
BROWSER_SERVICE_URL=http://browser:8000
YOUTUBE_SERVICE_URL=http://youtube:8000
EMBED_SERVICE_URL=http://embed:8000
CLIP_SERVICE_URL=http://clip:8000
RERANKER_SERVICE_URL=http://reranker:8000
GRAPH_SERVICE_URL=http://graph:8000
VECTOR_SERVICE_URL=http://vector:8000
CACHE_SERVICE_URL=http://cache:8000
GATEWAY_UPSTREAM_TIMEOUT=60
