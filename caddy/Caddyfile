{
    # Global options
    email {$CADDY_ACME_EMAIL:admin@example.com}
}

# Set DOMAIN in .env to your real domain to get automatic HTTPS.
# For local/IP-only access, Caddy falls back to serving plain HTTP on :80.
:{$HTTP_PORT:80} {
    encode gzip zstd

    # Responds to ANY host (IP or domain) — reverse proxies to the app.
    # Everything else (Neo4j, ChromaDB, Redis, SearXNG)
    # stays internal-only.
    reverse_proxy app:8000

    log {
        output file /data/access.log
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

